[Unit]
Description=Intel RAPL Power Monitor
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/veno/Projects/intel-rapl-power-monitor
ExecStart=/home/veno/.local/bin/uvicorn power_monitor.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PATH=/home/veno/.local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
